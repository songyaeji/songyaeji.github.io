---
import { execSync } from 'node:child_process';
import Base from '../layouts/Base.astro';
import { picks, pickSections } from '../data/picks';

// picks.ts를 마지막으로 손본 날짜를 빌드 시점에 git에서 뽑는다.
// 수정 후 아직 커밋 전(dirty)이거나 git 이력이 없으면 오늘 날짜로 대체.
const PICKS_DATA = 'src/data/picks.ts';
const run = (cmd: string): string => {
  try {
    return execSync(cmd, { encoding: 'utf8' }).trim();
  } catch {
    return '';
  }
};
const isDirty = run(`git status --porcelain -- ${PICKS_DATA}`) !== '';
const lastCommitDate = run(`git log -1 --format=%cs -- ${PICKS_DATA}`);
const picksUpdated =
  isDirty || !lastCommitDate
    ? new Date().toLocaleDateString('sv') // 로컬 타임존 기준 YYYY-MM-DD (ISOString은 UTC라 자정 전후 하루 밀림)
    : lastCommitDate;

const [uy, um, ud] = picksUpdated.split('-');
const updatedLabel = `${uy}년 ${Number(um)}월 ${Number(ud)}일`;

// 은퇴 항목은 본 목록에서 빼고 하단 아카이브에 모아 보여준다 —
// 추천에서 내려간 이유까지 남기는 것이 이 페이지의 아카이빙 방식.
const activePicks = picks.filter((p) => !p.archived);
const archivedPicks = picks.filter((p) => p.archived);

// 아카이브는 내린 날짜(배치)별로 묶어 최신 배치가 위로 오게 보여준다.
const archiveDates = [...new Set(archivedPicks.map((p) => p.archived!.date))].sort().reverse();
const archiveGroups = archiveDates.map((date) => ({
  date,
  items: archivedPicks.filter((p) => p.archived!.date === date),
}));
---

<Base title="Picks" description="직접 써보고 추천하는 AI skills·MCP·tools·articles 모음">
  <div class="page wrap">
    <p class="cli-label">cat picks.md</p>
    <h1 class="page-title">Picks</h1>
    <p class="lede">직접 써보고 좋았던 AI skills · MCP · tools · articles 모음입니다.</p>
    <p class="picks-updated">
      <span class="cli-label">git log -1 --format=%cd</span>
      <time datetime={picksUpdated}>{updatedLabel}</time> 기준으로 고른 목록입니다.
    </p>
    <div class="pick-columns">
      {
        pickSections.map((s) => {
          // 별(important) 항목을 위로 — 같은 등급끼리는 원래 순서 유지(stable sort)
          const group = activePicks
            .filter((p) => p.category === s.key)
            .sort((a, b) => Number(b.important ?? false) - Number(a.important ?? false));
          return (
            <section class="pick-section" data-cat={s.key}>
              <p class="cli-label">{s.cmd}</p>
              <ul class="pick-list">
                {group.map((p) => (
                  <li class="pick" class:list={{ important: p.important }}>
                    {p.important && <span class="pick-star" aria-label="중요" title="중요">⭐</span>}
                    {p.link ? <a href={p.link} rel="noopener">{p.name}</a> : <span class="pick-name">{p.name}</span>}
                    {p.date && <span class="pick-date">{p.date}</span>}
                    <p class="pick-tagline">{p.tagline}</p>
                    <details>
                      <summary>why</summary>
                      <p class="pick-reason">{p.reason}</p>
                    </details>
                  </li>
                ))}
              </ul>
            </section>
          );
        })
      }
    </div>
    {
      archivedPicks.length > 0 && (
        <section class="pick-archive">
          <p class="cli-label">ls picks/archive/</p>
          <details>
            <summary>한때 추천했던 것들 ({archivedPicks.length})</summary>
            {archiveGroups.map((g) => (
              <div class="archive-group">
                <p class="archive-date-label">{g.date} 아카이브 ({g.items.length})</p>
                <ul class="pick-list">
                  {g.items.map((p) => (
                    <li class="pick archived">
                      {p.link ? <a href={p.link} rel="noopener">{p.name}</a> : <span class="pick-name">{p.name}</span>}
                      <span class="pick-date">
                        {p.date ? `${p.date} ~ ` : ''}
                        {p.archived!.date}
                      </span>
                      <p class="pick-tagline">{p.tagline}</p>
                      <p class="pick-retired">
                        <span class="pick-retired-label">내린 이유</span> {p.archived!.reason}
                      </p>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </details>
        </section>
      )
    }
  </div>
</Base>
